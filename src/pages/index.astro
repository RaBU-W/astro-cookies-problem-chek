---
const backendUrl = import.meta.env.PUBLIC_BACKEND_URL ?? 'http://localhost:3001';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro Cookie Backend Demo</title>
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #0f172a;
        color: #e2e8f0;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at top left, rgba(56, 189, 248, 0.22), transparent 32rem),
          radial-gradient(circle at bottom right, rgba(168, 85, 247, 0.2), transparent 30rem),
          #0f172a;
      }

      main {
        width: min(92vw, 44rem);
        padding: 2rem;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 1.5rem;
        background: rgba(15, 23, 42, 0.82);
        box-shadow: 0 24px 80px rgba(2, 6, 23, 0.42);
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 8vw, 4rem);
        line-height: 1;
      }

      p {
        color: #cbd5e1;
        line-height: 1.7;
      }

      button {
        cursor: pointer;
        border: 0;
        border-radius: 999px;
        padding: 0.9rem 1.35rem;
        margin: 1rem 0;
        font-weight: 800;
        color: #082f49;
        background: linear-gradient(135deg, #67e8f9, #c4b5fd);
        box-shadow: 0 14px 34px rgba(103, 232, 249, 0.22);
      }

      button:disabled {
        cursor: wait;
        opacity: 0.72;
      }

      pre {
        min-height: 7rem;
        white-space: pre-wrap;
        word-break: break-word;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(2, 6, 23, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.2);
      }

      code {
        color: #93c5fd;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Cookie Round Trip</h1>
      <p>
        Button dabao: frontend backend ko call karega, backend browser me cookie set karega,
        aur 3 seconds baad backend wahi cookie read karke frontend ko value return karega.
      </p>
      <p>Backend host: <code id="backend-url">{backendUrl}</code></p>
      <button id="save-cookie">Save cookie via backend</button>
      <pre id="output">Ready. Click the button to start.</pre>
    </main>

    <script is:inline define:vars={{ backendUrl }}>
      const button = document.querySelector('#save-cookie');
      const output = document.querySelector('#output');

      const write = (message) => {
        output.textContent = message;
      };

      button.addEventListener('click', async () => {
        button.disabled = true;
        write('Saving cookie from backend...');

        try {
          const saveResponse = await fetch(`${backendUrl}/api/cookie`, {
            method: 'POST',
            credentials: 'include',
          });

          if (!saveResponse.ok) {
            throw new Error(`Save failed with status ${saveResponse.status}`);
          }

          const saved = await saveResponse.json();
          write(`Backend saved cookie: ${saved.cookieValue}\nWaiting 3 seconds before reading it...`);

          await new Promise((resolve) => setTimeout(resolve, 3000));

          const readResponse = await fetch(`${backendUrl}/api/cookie`, {
            credentials: 'include',
          });

          if (!readResponse.ok) {
            throw new Error(`Read failed with status ${readResponse.status}`);
          }

          const read = await readResponse.json();
          write(`Backend read cookie after 3 seconds:\n${read.cookieValue}`);
        } catch (error) {
          write(`Error: ${error.message}`);
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
